# From https://www.bungie.net/en/Application (create an app, OAuth client type: Confidential)
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=
# Must match the redirect URL registered on the Bungie app. Bungie requires https;
# the page does not need to load, you only copy the URL from the address bar.
BUNGIE_REDIRECT_URL=https://localhost:7777/callback
# Optional: where tokens, caches and settings live (default ~/.d2-vault-rater)
VAULT_RATER_HOME=
